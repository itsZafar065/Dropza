# ==============================================================================
# DROPZA ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# 1. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Dedicated WebRTC Signaling Service
NEXT_PUBLIC_SIGNALING_WS_URL="ws://localhost:3001"
SIGNALING_PORT="3001"
SIGNALING_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# 3. NextAuth Authentication & Session Encryption
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-string"

# 4. Database Persistence (PostgreSQL via Prisma)
# In production, use your PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dropza?schema=public"
# In zero-dependency local development, SQLite is supported:
# DATABASE_URL="file:./dev.db"

# 5. Private S3-Compatible Object Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# If credentials are not set, Dropza safely defaults to local zero-cloud signed storage.
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET="dropza-files"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
S3_FORCE_PATH_STYLE="false" # set to "true" for MinIO or local dev

# 6. Upload & File Size Limits (bytes)
# Default Max Upload Size for Guests: 50MB (52428800 bytes)
NEXT_PUBLIC_MAX_GUEST_UPLOAD_BYTES="52428800"
# Default Max Upload Size for Authenticated Users: 2GB (2147483648 bytes)
NEXT_PUBLIC_MAX_USER_UPLOAD_BYTES="2147483648"

# 7. WebRTC ICE Configuration (STUN / TURN)
# In corporate firewalls, a TURN relay server is required for direct WebRTC transfers.
NEXT_PUBLIC_ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]'
# Example with TURN relay server:
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.yourdomain.com:3478","username":"user","credential":"password"}]'

# 8. Background Cleanup Cron Protection
CRON_SECRET="generate-a-secure-cron-secret-token"

# 9. Rate Limiting Settings
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_UPLOAD_MAX_PER_HOUR="20"
